    {
      "id": "log-diagnosis",
      "name": "Log root-cause diagnosis",
      "workload": "knowledge base",
      "context_tokens": 8192,
      "no_workload_hint": "Build or open a knowledge base and the advisor will tell you whether your code base is large enough for a bigger model to be worth downloading.",
      "tiers": [
        {
          "label": "small",
          "below": {
            "lines": 15000,
            "symbols": 1500
          },
          "explain": "A small model can follow a code base of this size.",
