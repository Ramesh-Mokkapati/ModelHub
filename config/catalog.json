            "qwen2.5-coder-3b",
            "gemma-3-4b"
          ]
        },
        {
          "label": "medium",
          "below": {
            "lines": 150000,
            "symbols": 15000
          },
          "explain": "At this size a 7B model reasons noticeably better about how the parts fit together.",
