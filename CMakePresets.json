{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64 (vcpkg)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64 (vcpkg)",
      "inherits": "vs2026-x64",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build-vs2022"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release"
    },
    {
      "name": "package",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "targets": [
        "package"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
