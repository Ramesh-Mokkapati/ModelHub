#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MODELHUB_VER_MAJOR,MODELHUB_VER_MINOR,MODELHUB_VER_PATCH,MODELHUB_VER_BUILD
 PRODUCTVERSION MODELHUB_VER_MAJOR,MODELHUB_VER_MINOR,MODELHUB_VER_PATCH,MODELHUB_VER_BUILD
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "ModelHub SDK - model selection, shared store and downloads for llama.cpp"
      VALUE "FileVersion", MODELHUB_VERSION
      VALUE "ProductName", "ModelHub"
      VALUE "ProductVersion", MODELHUB_VERSION
      VALUE "OriginalFilename", "ModelHubSdk.dll"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
