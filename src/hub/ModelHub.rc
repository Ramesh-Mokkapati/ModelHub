#include <winver.h>

1 ICON "res/modelhub.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MODELHUB_VER_MAJOR,MODELHUB_VER_MINOR,MODELHUB_VER_PATCH,MODELHUB_VER_BUILD
 PRODUCTVERSION MODELHUB_VER_MAJOR,MODELHUB_VER_MINOR,MODELHUB_VER_PATCH,MODELHUB_VER_BUILD
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "ModelHub - shared local models for llama.cpp"
      VALUE "FileVersion", MODELHUB_VERSION
      VALUE "ProductName", "ModelHub"
      VALUE "ProductVersion", MODELHUB_VERSION
      VALUE "OriginalFilename", "ModelHub.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
