#include <winver.h>
#include <winresrc.h>
#include <commctrl.h>

#include "resource.h"

IDI_APP          ICON "res/modelhub.ico"
IDI_TRAY_RUNNING ICON "res/tray_running.ico"
IDI_TRAY_STOPPED ICON "res/tray_stopped.ico"
IDI_TRAY_BUSY    ICON "res/tray_busy.ico"

// Positions are placeholders: ManagerWindow.cpp lays the window out (it is resizable).
IDD_MANAGER DIALOGEX 0, 0, 560, 380
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "ModelHub - models for every application"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_HARDWARE, 0, 0, 10, 10, SS_ENDELLIPSIS
    LTEXT           "", IDC_SERVICE, 0, 0, 10, 10, SS_ENDELLIPSIS
    PUSHBUTTON      "&Start", IDC_SERVICE_START, 0, 0, 10, 10
    PUSHBUTTON      "S&top", IDC_SERVICE_STOP, 0, 0, 10, 10
    PUSHBUTTON      "R&estart", IDC_SERVICE_RESTART, 0, 0, 10, 10
    LTEXT           "Suggest &models for:", IDC_TASK_LABEL, 0, 0, 10, 10
    COMBOBOX        IDC_TASK, 0, 0, 10, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_NOTES, 0, 0, 10, 10
    CONTROL         "", IDC_MODELS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 0, 0, 10, 10
    LTEXT           "", IDC_DETAILS, 0, 0, 10, 10
    CONTROL         "", IDC_PROGRESS, "msctls_progress32", 0, 0, 0, 10, 10
    LTEXT           "", IDC_PROGRESS_TEXT, 0, 0, 10, 10, SS_ENDELLIPSIS
    DEFPUSHBUTTON   "&Download", IDC_DOWNLOAD, 0, 0, 10, 10
    PUSHBUTTON      "&Cancel download", IDC_CANCEL_DOWNLOAD, 0, 0, 10, 10
    PUSHBUTTON      "De&lete...", IDC_DELETE, 0, 0, 10, 10
    PUSHBUTTON      "Show in &folder", IDC_SHOW, 0, 0, 10, 10
    PUSHBUTTON      "Browse &Hugging Face...", IDC_ADD_HF, 0, 0, 10, 10
    PUSHBUTTON      "Add f&older...", IDC_ADD_FOLDER, 0, 0, 10, 10
    PUSHBUTTON      "&Rescan", IDC_RESCAN, 0, 0, 10, 10
    LTEXT           "", IDC_STORE, 0, 0, 10, 10, SS_ENDELLIPSIS
END

// Positions are placeholders: HfBrowser.cpp lays the window out (it is resizable).
IDD_HF_BROWSER DIALOGEX 0, 0, 600, 380
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "Browse Hugging Face - GGUF models for this PC"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Search:", IDC_HF_LABEL, 0, 0, 10, 10
    EDITTEXT        IDC_HF_QUERY, 0, 0, 10, 10, ES_AUTOHSCROLL
    COMBOBOX        IDC_HF_KIND, 0, 0, 10, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_HF_SORT, 0, 0, 10, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "Searc&h", IDC_HF_SEARCH, 0, 0, 10, 10
    AUTOCHECKBOX    "Only models that run on this &PC", IDC_HF_FITONLY, 0, 0, 10, 10
    CONTROL         "", IDC_HF_RESULTS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 0, 0, 10, 10
    EDITTEXT        IDC_HF_INFO, 0, 0, 10, 10, ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOVSCROLL
    CONTROL         "", IDC_HF_FILES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 0, 0, 10, 10
    LTEXT           "", IDC_HF_STATUS, 0, 0, 10, 10, SS_ENDELLIPSIS
    PUSHBUTTON      "&Open on huggingface.co", IDC_HF_OPEN, 0, 0, 10, 10
    PUSHBUTTON      "&Download", IDC_HF_DOWNLOAD, 0, 0, 10, 10
    PUSHBUTTON      "Close", IDCANCEL, 0, 0, 10, 10
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MODELHUB_VER_MAJOR,MODELHUB_VER_MINOR,MODELHUB_VER_PATCH,MODELHUB_VER_BUILD
 PRODUCTVERSION MODELHUB_VER_MAJOR,MODELHUB_VER_MINOR,MODELHUB_VER_PATCH,MODELHUB_VER_BUILD
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "ModelHub Manager - suggest, download and delete local models; control the ModelHub service"
      VALUE "FileVersion", MODELHUB_VERSION
      VALUE "ProductName", "ModelHub"
      VALUE "ProductVersion", MODELHUB_VERSION
      VALUE "OriginalFilename", "ModelHubManager.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
