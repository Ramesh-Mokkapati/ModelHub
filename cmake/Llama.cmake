# Downloads, verifies and stages llama.cpp's server into ${MODELHUB_LLAMA_DIR} at configure time.
# Archives are cached in MODELHUB_DOWNLOAD_CACHE, so later configures (and CI with a cache) work offline.

set(MODELHUB_LLAMA_BUILD "b11938")
set(MODELHUB_LLAMA_VULKAN_URL "https://github.com/ggml-org/llama.cpp/releases/download/b11938/llama-b11938-bin-win-vulkan-x64.zip")
set(MODELHUB_LLAMA_VULKAN_SHA256 "9ecd072c6e785fa2b932229c86f845695198195c4f29b99b85ed42dccb022aa6")
set(MODELHUB_LLAMA_CPU_URL "https://github.com/ggml-org/llama.cpp/releases/download/b11938/llama-b11938-bin-win-cpu-x64.zip")
set(MODELHUB_LLAMA_CPU_SHA256 "9e2fc62604446d86809ca09094d3c7a7329b723bda636e4bbd23c3ce62cb77dc")
set(MODELHUB_LLAMA_CUDA_URL "https://github.com/ggml-org/llama.cpp/releases/download/b11938/llama-b11938-bin-win-cuda-12.4-x64.zip")
set(MODELHUB_LLAMA_CUDA_SHA256 "91e8c63d59c080ea1b4f042911489b27d3ee019f323bc0556111c83dcab410c8")
set(MODELHUB_LLAMA_CUDART_URL "https://github.com/ggml-org/llama.cpp/releases/download/b11938/cudart-llama-bin-win-cuda-12.4-x64.zip")
set(MODELHUB_LLAMA_CUDART_SHA256 "8c79a9b226de4b3cacfd1f83d24f962d0773be79f1e7b75c6af4ded7e32ae1d6")

option(MODELHUB_BUNDLE_LLAMA "Download and bundle llama.cpp's llama-server" ON)
set(MODELHUB_LLAMA_BACKEND "vulkan" CACHE STRING "llama.cpp build to bundle: vulkan, cuda or cpu")
set_property(CACHE MODELHUB_LLAMA_BACKEND PROPERTY STRINGS vulkan cuda cpu)
set(MODELHUB_DOWNLOAD_CACHE "${CMAKE_SOURCE_DIR}/.downloads" CACHE PATH "Cache folder for downloaded archives")
set(MODELHUB_SDK_DIR "${CMAKE_BINARY_DIR}/sdk")
set(MODELHUB_LLAMA_DIR "${MODELHUB_SDK_DIR}/bin/llama")

function(modelhub_download label url sha256 out_var)
  get_filename_component(name "${url}" NAME)
  set(file "${MODELHUB_DOWNLOAD_CACHE}/${name}")
  if(EXISTS "${file}")
    file(SHA256 "${file}" actual)
    if(NOT actual STREQUAL sha256)
      message(WARNING "${label}: cached ${name} has the wrong hash, downloading again")
      file(REMOVE "${file}")
    endif()
  endif()
  if(NOT EXISTS "${file}")
    message(STATUS "Downloading ${label}: ${url}")
    file(MAKE_DIRECTORY "${MODELHUB_DOWNLOAD_CACHE}")
    file(DOWNLOAD "${url}" "${file}.part" EXPECTED_HASH SHA256=${sha256} TLS_VERIFY ON INACTIVITY_TIMEOUT 120
         STATUS status SHOW_PROGRESS)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      file(REMOVE "${file}.part")
      list(GET status 1 msg)
      message(FATAL_ERROR "${label}: download failed (${code}): ${msg}\n"
                          "Configure with -DMODELHUB_BUNDLE_LLAMA=OFF and set \"llama_server\" in config.json instead.")
    endif()
    file(RENAME "${file}.part" "${file}")
  endif()
  set(${out_var} "${file}" PARENT_SCOPE)
endfunction()

if(NOT MODELHUB_BUNDLE_LLAMA)
  message(STATUS "llama.cpp: not bundled (set \"llama_server\" in %LOCALAPPDATA%\\ModelHub\\config.json)")
  return()
endif()

if(MODELHUB_LLAMA_BACKEND STREQUAL "cuda")
  modelhub_download("llama.cpp ${MODELHUB_LLAMA_BUILD} (CUDA 12.4)" "${MODELHUB_LLAMA_CUDA_URL}" "${MODELHUB_LLAMA_CUDA_SHA256}" llama_zip)
  modelhub_download("CUDA 12.4 runtime" "${MODELHUB_LLAMA_CUDART_URL}" "${MODELHUB_LLAMA_CUDART_SHA256}" cudart_zip)
  set(stamp "${MODELHUB_LLAMA_CUDA_SHA256}-${MODELHUB_LLAMA_CUDART_SHA256}")
elseif(MODELHUB_LLAMA_BACKEND STREQUAL "cpu")
  modelhub_download("llama.cpp ${MODELHUB_LLAMA_BUILD} (CPU)" "${MODELHUB_LLAMA_CPU_URL}" "${MODELHUB_LLAMA_CPU_SHA256}" llama_zip)
  set(stamp "${MODELHUB_LLAMA_CPU_SHA256}")
else()
  modelhub_download("llama.cpp ${MODELHUB_LLAMA_BUILD} (Vulkan)" "${MODELHUB_LLAMA_VULKAN_URL}" "${MODELHUB_LLAMA_VULKAN_SHA256}" llama_zip)
  set(stamp "${MODELHUB_LLAMA_VULKAN_SHA256}")
endif()

set(old "")
if(EXISTS "${MODELHUB_LLAMA_DIR}/.modelhub-stamp")
  file(READ "${MODELHUB_LLAMA_DIR}/.modelhub-stamp" old)
endif()
if(NOT old STREQUAL stamp)
  message(STATUS "Extracting llama.cpp -> ${MODELHUB_LLAMA_DIR}")
  file(REMOVE_RECURSE "${MODELHUB_LLAMA_DIR}")
  file(ARCHIVE_EXTRACT INPUT "${llama_zip}" DESTINATION "${MODELHUB_LLAMA_DIR}")
  if(cudart_zip)
    file(ARCHIVE_EXTRACT INPUT "${cudart_zip}" DESTINATION "${MODELHUB_LLAMA_DIR}")
  endif()
  file(GLOB children LIST_DIRECTORIES true "${MODELHUB_LLAMA_DIR}/*")
  list(LENGTH children n)
  if(n EQUAL 1 AND IS_DIRECTORY "${children}")  # a single top-level folder: flatten it
    file(GLOB inner "${children}/*")
    file(COPY ${inner} DESTINATION "${MODELHUB_LLAMA_DIR}")
    file(REMOVE_RECURSE "${children}")
  endif()
  if(NOT EXISTS "${MODELHUB_LLAMA_DIR}/llama-server.exe")
    message(FATAL_ERROR "llama.cpp archive did not contain llama-server.exe")
  endif()
  file(WRITE "${MODELHUB_LLAMA_DIR}/BACKEND.txt" "${MODELHUB_LLAMA_BUILD} ${MODELHUB_LLAMA_BACKEND}")
  file(WRITE "${MODELHUB_LLAMA_DIR}/.modelhub-stamp" "${stamp}")
endif()
message(STATUS "llama.cpp ${MODELHUB_LLAMA_BUILD} (${MODELHUB_LLAMA_BACKEND}) in ${MODELHUB_LLAMA_DIR}")
