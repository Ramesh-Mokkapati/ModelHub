# A solution at the root of the sources for the projects CMake writes into the build folder, so Visual Studio
# opens RevEng from C:\...\RevEng itself:
#   ModelHub.sln   the classic format (Visual Studio 2022 and later)
#   ModelHub.slnx  the XML format (Visual Studio 2026)
# Written at configure time. The project GUIDs are the ones CMake gives its .vcxproj files: an MD5 UUID of
# "<build folder>|<target>". Dependencies between projects are ProjectReferences in the .vcxproj files, so the
# solution only lists the projects. The first one (ModelHub) is the startup project.
option(MODELHUB_ROOT_SOLUTION "Write ModelHub.sln / .slnx at the root of the sources" ON)
if(NOT MODELHUB_ROOT_SOLUTION OR NOT CMAKE_GENERATOR MATCHES "^Visual Studio (17|18)")
  return()
endif()

set(modelhub_solution_projects
  ModelHub ModelHubManager ModelHubSdk ModelHubService ModelHubCore ModelHubTests ModelHubClientCxx14 ModelHubCxx14Check
  ALL_BUILD ZERO_CHECK)
file(RELATIVE_PATH modelhub_build_rel "${CMAKE_SOURCE_DIR}" "${CMAKE_BINARY_DIR}")

# Both formats, whichever generator configured the build: the classic .sln (VS 2022 and later) and the .slnx (VS 2026).
if(TRUE)
  set(vcxproj_type "8BC9CEB8-8B4A-11D0-8D11-00A0C91BC942")
  string(CONCAT sln "\nMicrosoft Visual Studio Solution File, Format Version 12.00\n# Visual Studio Version 17\n"
                    "VisualStudioVersion = 17.0.31903.59\nMinimumVisualStudioVersion = 10.0.40219.1\n")
  set(configs "")
  foreach(p IN LISTS modelhub_solution_projects)
    get_filename_component(name "${p}" NAME)
    string(UUID guid NAMESPACE ee30c4be-5192-4fb0-b335-722a2dffe760 NAME "${CMAKE_BINARY_DIR}|${name}" TYPE MD5 UPPER)
    string(REPLACE "/" "\\" path "${modelhub_build_rel}/${p}.vcxproj")
    string(APPEND sln "Project(\"{${vcxproj_type}}\") = \"${name}\", \"${path}\", \"{${guid}}\"\nEndProject\n")
    foreach(c Debug Release)
      string(APPEND configs "\t\t{${guid}}.${c}|x64.ActiveCfg = ${c}|x64\n")
      if(NOT name STREQUAL "ZERO_CHECK")  # CMake's own rule: ZERO_CHECK runs as a dependency, not on its own
        string(APPEND configs "\t\t{${guid}}.${c}|x64.Build.0 = ${c}|x64\n")
      endif()
    endforeach()
  endforeach()
  string(APPEND sln "Global\n"
                    "\tGlobalSection(SolutionConfigurationPlatforms) = preSolution\n"
                    "\t\tDebug|x64 = Debug|x64\n\t\tRelease|x64 = Release|x64\n"
                    "\tEndGlobalSection\n"
                    "\tGlobalSection(ProjectConfigurationPlatforms) = postSolution\n${configs}"
                    "\tEndGlobalSection\n"
                    "\tGlobalSection(SolutionProperties) = preSolution\n\t\tHideSolutionNode = FALSE\n"
                    "\tEndGlobalSection\n"
                    "EndGlobal\n")
  # Visual Studio's solution files start with a UTF-8 byte order mark.
  string(ASCII 239 187 191 bom)
  file(WRITE "${CMAKE_SOURCE_DIR}/ModelHub.sln" "${bom}${sln}")
endif()
if(TRUE)
  string(CONCAT slnx "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
           "<!-- Generated by CMake (cmake/RootSolution.cmake): the projects in ${modelhub_build_rel}/. Reconfigure to update. -->\n"
           "<Solution>\n  <Configurations>\n    <BuildType Name=\"Debug\"/>\n    <BuildType Name=\"Release\"/>\n"
           "    <Platform Name=\"x64\"/>\n  </Configurations>\n")
  foreach(p IN LISTS modelhub_solution_projects)
    set(extra "")
    if(p STREQUAL "ModelHub")
      set(extra " DefaultStartup=\"true\"")
    endif()
    string(APPEND slnx "  <Project Path=\"${modelhub_build_rel}/${p}.vcxproj\"${extra}/>\n")
  endforeach()
  string(APPEND slnx "</Solution>\n")
  file(WRITE "${CMAKE_SOURCE_DIR}/ModelHub.slnx" "${slnx}")
endif()
